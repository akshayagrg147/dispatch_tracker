# AWS RDS PostgreSQL connection string.
# URL-encode special characters in the password.
DATABASE_URL=postgresql://dispatch_app:replace-me@your-rds-endpoint.amazonaws.com:5432/dispatch_register

# Use PGSSL=true for AWS RDS. For a quick initial setup, the example below
# skips CA verification; use your AWS RDS CA and set this to true in production.
PGSSL=true
PGSSL_REJECT_UNAUTHORIZED=false
# Optional: absolute path to the AWS RDS CA bundle when verification is enabled.
# PGSSL_CA_PATH=/run/secrets/global-bundle.pem

# Use a long random value. Never commit the real value.
JWT_SECRET=replace-with-a-long-random-secret
PORT=8000
NODE_ENV=development
COOKIE_SECURE=false

# Optional courier tracking. Leave blank to keep manual tracking only.
TRACK_PROVIDER=aftership
TRACK_API_KEY=
TRACK_BASE_URL=
TRACK_AUTH_HEADER=
